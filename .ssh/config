# Machine-specific or private hosts go in ~/.ssh/config.local (untracked).
Include ~/.ssh/config.local

Host *
  # Load keys into the agent on first use, reading their passphrases
  # from the macOS login Keychain. Store a passphrase there once with:
  #   ssh-add --apple-use-keychain ~/.ssh/id_ed25519
  # UseKeychain is Apple-only, so other ssh builds skip it.
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
